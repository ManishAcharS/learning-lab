# Copy this file to .env and replace the placeholder values.
# .env is ignored by Git and excluded from the Docker build context.
#
# PostgreSQL connection used by the API. The hostname ``db`` is the Compose
# service name, so this URL only works from inside Docker Compose.
# Percent-encode special characters in the password when putting it in a URL.
DATABASE_URL=postgresql+psycopg://taskflow:change-this-local-password@db:5432/taskflow

# PostgreSQL container settings. Keep these consistent with DATABASE_URL.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-this-local-password

# JWT signing key. The application has no fallback secret, so this is required.
# Generate a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
TASKFLOW_JWT_SECRET=replace-with-a-long-random-secret
